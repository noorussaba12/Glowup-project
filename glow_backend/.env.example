# Glow AI Skin Health Backend Configuration
PORT=5000

# Google Gemini Vision API Key (from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model name: gemini-1.5-flash or gemini-2.0-flash
AI_MODEL_NAME=gemini-1.5-flash

# Firebase Admin SDK (Optional, for server-side token validation)
# FIREBASE_PROJECT_ID=glow-skin-health
